

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  lastname   String
  firstname  String
  email      String   @unique
  password   String
  followings Int       @default(0)
  followers  Int       @default(0)
  createdAt  DateTime @default(now())
  profile   Profile?
  posts     Post[]
  likes      Like[]
}

model Post {
  id        Int  @id @default(autoincrement())
  username  String
  text      String
  createdAt DateTime @default(now()) 
  author    User      @relation(fields: [authorId], references: [id])
  authorId  Int
  likes      Like[]
  comments  Comment[] 
}

model Profile {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  firstname  String
  lastname   String
  email      String   @unique
  password   String
  bio        String
  followings String
  followers  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int   @unique
}
model Comment {
  id      Int  @id @default(autoincrement())
  username  String
  comment   String
  createdAt DateTime @default(now())
  // relatoion with the post and user models
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
}
model Like {
  id        Int  @id @default(autoincrement())  
  username  String
  createdAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  @@unique([userId, postId])
}




